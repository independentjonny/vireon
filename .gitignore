# dependencies
/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage/
playwright-report/
test-results/

# next.js / build outputs
/.next/
/out/
/build/
*.tsbuildinfo
next-env.d.ts

# environment and secrets
.env
.env.*
!.env.example
*.pem

# Vercel local project metadata
.vercel/

# local runtime / operator state
.ai-supervisor/
.ai/local-data/
.codex-bridge/
.vireon/
.ai-agent-runs/
.verification/

# temporary files and logs
.tmp-*
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# OS/editor noise
.DS_Store
