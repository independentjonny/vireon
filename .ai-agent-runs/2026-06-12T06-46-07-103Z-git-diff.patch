+        `Status text: ${response.statusText}`,
+        "JSON error body:",
+        summarizeOutput(JSON.stringify(payload), 2_000),
+      ].join("\n")
+    );
+  }
+
+  const text = responseTextFromOpenAI(payload);
+  if (!text) throw new Error("OpenAI Responses API returned no review text.");
+  return text;
