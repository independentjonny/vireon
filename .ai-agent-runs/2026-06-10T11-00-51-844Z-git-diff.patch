+function modifiedFilesFromStatus(status: string) {
+  return status
+    .split(/\r?\n/)
+    .map((line) => line.trimEnd())
+    .filter(Boolean)
+    .map((line) => line.slice(3).replace(/^.* -> /, "").replaceAll("\\", "/"))
+    .filter(Boolean);
+}
+
+function targetFilesFromTask(task: string) {
